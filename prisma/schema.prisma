generator client {
  provider = "prisma-client"
  output   = "../apps/web/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String        @id
  issuer                String
  subject               String
  displayName           String
  role                  String        @default("MEMBER")
  publishingStatus      String        @default("ACTIVE")
  publishingRestrictedUntil DateTime?
  leaderboardEligible   Boolean       @default(false)
  leaderboardOptIn      Boolean       @default(false)
  uiLocale              String        @default("en")
  contentLocale         String        @default("en")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  quizzes               Quiz[]
  packs                 QuizPack[]
  editorialFeatures     EditorialFeature[]
  packReviews           PackReview[]
  packReports           PackReport[]
  sessions              PlaySession[]
  reviews               Review[]
  reports               Report[]
  moderationNotices     ModerationNotice[]
  moderationAppeals     ModerationAppeal[]
  mediaAssets           MediaAsset[]
  playRuns              PlayRun[]
  creatorReviewsReceived CreatorReview[] @relation("CreatorReceived")
  creatorReviewsWritten  CreatorReview[] @relation("CreatorWritten")
  kidProfiles           KidProfile[]
  kidDeviceSessions     KidDeviceSession[]
  kidGuardianPin        KidGuardianPin?
  kidPairTickets        KidPairTicket[]
  kidPairRequests       KidPairRequest[]
  kidParentAccess       KidParentAccess[]
  @@unique([issuer, subject])
  @@index([leaderboardEligible, leaderboardOptIn])
}

model Quiz {
  id                    String        @id @default(uuid())
  authorId              String
  author                User          @relation(fields: [authorId], references: [id])
  currentVersion        Int           @default(1)
  sourceLocale          String        @default("und")
  localizations         QuizLocalization[]
  kidSafetyReports      KidSafetyReport[]
  publication           String        @default("DRAFT")
  safetyStatus          String        @default("ACTIVE")
  kidsEligible          Boolean       @default(false)
  kidsReviewStatus      String        @default("NOT_REQUESTED")
  moderationReviewedAt  DateTime?
  creatorIntent         Json?
  recommendedAudience   Json?
  mode                  String        @default("progressive-clues")
  answerType            String        @default("other")
  topicLinks            QuizTopic[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  revisions             QuizRevision[]
  packItems             PackQuestion[]
  editorialFeatures     EditorialFeature[]
  runQuestions          PlayRunQuestion[]
  sessions              PlaySession[]
  reviews               Review[]
  reports               Report[]
  @@index([publication, updatedAt])
  @@index([authorId, updatedAt])
}

model QuizRevision {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  version               Int
  localizationId        String?
  localization          QuizLocalization? @relation(fields: [localizationId], references: [id], onDelete: SetNull)
  title                 String
  prompt                String
  explanation           String        @default("")
  mode                  String
  answerType            String        @default("other")
  answer                Json
  clues                 Json
  scoring               Json?
  promptMediaIds        Json          @default("[]")
  createdAt             DateTime      @default(now())
  sessions              PlaySession[]
  runQuestions          PlayRunQuestion[]
  reviews               Review[]
  reports               Report[]
  @@index([quizId, version])
  @@unique([localizationId, version])
}

model QuizLocalization {
  id               String   @id @default(uuid())
  quizId           String
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  locale           String
  status           String   @default("DRAFT")
  currentVersion   Int      @default(1)
  publishedVersion Int?
  sourceRevisionId String?
  origin           String   @default("ORIGINAL")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  revisions        QuizRevision[]
  @@unique([quizId, locale])
  @@index([locale, status])
}

model Topic {
  id          String      @id @default(uuid())
  key         String      @unique
  name        String
  aliases     String[]    @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quizLinks   QuizTopic[]
  localizations TopicLocalization[]
}

model TopicLocalization {
  id        String   @id @default(uuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  locale    String
  name      String
  aliases   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([topicId, locale])
  @@index([locale, name])
}

model QuizTopic {
  quizId      String
  topicId     String
  position    Int
  isSpoiler   Boolean     @default(false)
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  topic       Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([quizId, topicId])
  @@index([quizId, position])
  @@index([topicId, isSpoiler])
}

model QuizPack {
  id                    String        @id @default(uuid())
  currentVersion        Int           @default(1)
  orderMode             String        @default("CREATOR")
  safetyStatus          String        @default("ACTIVE")
  kidsEligible          Boolean       @default(false)
  kidsReviewStatus      String        @default("NOT_REQUESTED")
  editorialFeatures     EditorialFeature[]
  authorId              String
  author                User          @relation(fields: [authorId], references: [id])
  title                 String
  description           String        @default("")
  coverMediaId          String?
  sections              Json          @default("[]")
  closingMessage        String        @default("")
  scoreReviews          Json          @default("[]")
  sourceLocale          String        @default("und")
  localizations         QuizPackLocalization[]
  publication           String        @default("DRAFT")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  items                 PackQuestion[]
  runs                  PlayRun[]
  reviews               PackReview[]
  reports               PackReport[]
  @@index([kidsReviewStatus, publication])
}

/** Trusted editorial placement: selection never implies identity verification. */
model EditorialFeature {
  id           String    @id @default(uuid())
  targetType   String
  quizId       String?
  quiz         Quiz?     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  packId       String?
  pack         QuizPack? @relation(fields: [packId], references: [id], onDelete: Cascade)
  locale       String
  lane         String    @default("GENERAL")
  placement    String    @default("ROW")
  priority     Int       @default(0)
  headline     String    @default("")
  description  String    @default("")
  status       String    @default("ACTIVE")
  startAt      DateTime
  endAt        DateTime
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([locale, lane, status, placement, startAt, endAt])
  @@index([packId])
  @@index([quizId])
}

model QuizPackLocalization {
  id             String   @id @default(uuid())
  packId         String
  pack           QuizPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  locale         String
  title          String
  description    String   @default("")
  sections       Json     @default("[]")
  closingMessage String   @default("")
  scoreReviews   Json     @default("[]")
  status         String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([packId, locale])
  @@index([locale, status])
}

model PackReview {
  id                    String   @id @default(uuid())
  packId                String
  pack                  QuizPack @relation(fields: [packId], references: [id], onDelete: Restrict)
  authorId              String
  author                User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  locale                String   @default("und")
  rating                Int
  comment               String   @default("")
  packVersionAtReview   Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@unique([packId, authorId, locale])
  @@index([packId, locale, rating])
}

model PackReport {
  id                    String   @id @default(uuid())
  packId                String
  pack                  QuizPack @relation(fields: [packId], references: [id], onDelete: Restrict)
  reporterId            String
  reporter              User     @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  locale                String   @default("und")
  reason                String
  detail                String   @default("")
  status                String   @default("OPEN")
  createdAt             DateTime @default(now())
  @@index([packId, status])
  @@index([packId, reporterId, status])
  @@index([packId, locale, reason])
  @@index([reporterId, createdAt])
}

model PackQuestion {
  packId                String
  quizId                String
  position              Int
  pack                  QuizPack      @relation(fields: [packId], references: [id], onDelete: Cascade)
  quiz                  Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  @@id([packId, quizId])
  @@unique([packId, position])
}

model PlaySession {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id])
  revisionId            String
  revision              QuizRevision  @relation(fields: [revisionId], references: [id])
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id])
  tokenHash             String
  locale                String        @default("und")
  runId                 String?
  run                   PlayRun? @relation(fields: [runId], references: [id])
  roundIndex            Int?
  status                String        @default("ACTIVE")
  usedClues             Int           @default(1)
  wrongGuesses          Int           @default(0)
  firstChoice           String?       // Validated first submitted authored MC option; nullable before collection
  score                 Int           @default(0)
  startedAt             DateTime      @default(now())
  expiresAt             DateTime
  finishedAt            DateTime?
  kidSingle   KidPlaySingle?
  @@unique([runId, roundIndex])
  @@index([quizId, revisionId, status])
  @@index([userId, status, score])
  @@index([userId, status, finishedAt])
  @@index([status, finishedAt])
  @@index([startedAt])
}

model Review {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id])
  authorId              String
  author                User          @relation(fields: [authorId], references: [id])
  rating                Int
  locale                String        @default("und")
  kind                  String        @default("QUIZ")
  revisionId            String?
  revision              QuizRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  comment               String        @default("")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  @@unique([quizId, authorId, locale, kind])
  @@index([quizId, locale, kind, rating])
  @@index([quizId, kind, rating, updatedAt])
  @@index([quizId, createdAt])
}

model Report {
  id                    String        @id @default(uuid())
  quizId                String
  quiz                  Quiz          @relation(fields: [quizId], references: [id])
  reporterId            String
  reporter              User          @relation(fields: [reporterId], references: [id])
  locale                String        @default("und")
  revisionId            String?
  revision              QuizRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  reason                String
  detail                String        @default("")
  status                String        @default("OPEN")
  createdAt             DateTime      @default(now())
  @@index([quizId, status])
  @@index([quizId, status, createdAt])
  @@index([quizId, reporterId, status])
  @@index([quizId, locale, reason])
}

/** Admin-configurable report hold policy; key "default" is a singleton. */
model ModerationPolicy {
  id                          String   @id
  enabled                     Boolean  @default(true)
  quizReportThreshold         Int      @default(3)
  packReportThreshold         Int      @default(3)
  windowHours                 Int      @default(24)
  minimumEstablishedReporters Int      @default(2)
  establishedAccountDays      Int      @default(7)
  updatedById                 String?
  updatedAt                   DateTime @updatedAt
}

/** Private creator notification; never include reporter identities in messages. */
model ModerationNotice {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetKind  String
  targetId    String
  event       String
  message     String    @default("")
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/** Creator appeals do not directly change trusted moderation decisions. */
model ModerationAppeal {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetKind   String
  targetId     String
  message      String
  status       String    @default("OPEN")
  resolution   String    @default("")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([targetKind, targetId, status])
}

model AuditLog {
  id                    String        @id @default(uuid())
  actorId               String
  action                String
  objectId              String
  detail                Json?
  createdAt             DateTime      @default(now())
  @@index([actorId, createdAt])
  @@index([objectId, action, createdAt])
}

model CreatorReview {
  id         String   @id @default(uuid())
  targetId   String
  reviewerId String
  target     User     @relation("CreatorReceived", fields: [targetId], references: [id])
  reviewer   User     @relation("CreatorWritten", fields: [reviewerId], references: [id])
  rating     Int
  comment    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([targetId, reviewerId])
  @@index([targetId, createdAt])
}

model MediaAsset {
  id                String   @id @default(uuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  kind              String
  mimeType          String
  originalName      String   @default("")
  sizeBytes         Int
  sha256            String?
  status            String   @default("UPLOADING")
  moderationStatus  String   @default("PENDING")
  storageKey        String   @unique
  uploadKey         String?  @unique
  uploadExpiresAt   DateTime?
  sourceUrl         String?
  parentId          String?
  alt               String   @default("")
  transcript        String   @default("")
  attribution       String   @default("")
  license           String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  @@index([ownerId, status, createdAt])
  @@index([parentId])
}

model PlayRun {
  id          String    @id @default(uuid())
  mode        String
  lane        String
  locale      String    @default("und")
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  packId      String?
  pack        QuizPack? @relation(fields: [packId], references: [id], onDelete: Restrict)
  packVersion Int?
  tokenHash   String
  currentIndex Int      @default(0)
  targetCount  Int?
  score       Int       @default(0)
  solved      Int       @default(0)
  failed      Int       @default(0)
  status      String    @default("ACTIVE")
  expiresAt   DateTime
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  shareId     String?   @unique
  sharedAt    DateTime?
  questions   PlayRunQuestion[]
  sessions    PlaySession[]
  kidOwnership KidPlayRun?
  @@index([userId, startedAt])
  @@index([packId, status, startedAt])
  @@index([startedAt])
}

model PlayRunQuestion {
  runId       String
  position    Int
  quizId      String
  revisionId  String
  run         PlayRun @relation(fields: [runId], references: [id])
  quiz        Quiz @relation(fields: [quizId], references: [id])
  revision    QuizRevision @relation(fields: [revisionId], references: [id])
  @@id([runId, position])
  @@index([runId, quizId])
}

/** Child profiles are owned by verified guardian QuizDip accounts, never public users. */
model KidProfile {
  id              String   @id @default(uuid())
  guardianId      String
  guardian        User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  nickname        String
  ageBand         String   @default("MIDDLE")
  locale          String   @default("en")
  sessionMinutes  Int      @default(0) // Legacy web-only session expiration
  dailyMinutes    Int      @default(0) // 0 = unlimited
  playSessionMinutes Int  @default(0) // 0 = unlimited
  breakEveryMinutes Int  @default(0) // reminder; does not bypass hard caps
  timeZone        String   @default("Pacific/Auckland")
  usageMinutes    KidUsageMinute[]
  safetyReports   KidSafetyReport[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  devices         KidDeviceSession[]
  playRuns        KidPlayRun[]
  singlePlays     KidPlaySingle[]
  pairTickets     KidPairTicket[]
  pairRequests    KidPairRequest[]
  @@index([guardianId, updatedAt])
}

model KidGuardianPin {
  guardianId       String   @id
  guardian         User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  hash             String
  attempts         Int      @default(0)
  lockedUntil      DateTime?
  pairCodeAttempts Int      @default(0)
  pairCodeLockedUntil DateTime?
  updatedAt        DateTime @updatedAt
}

model KidDeviceSession {
  id           String   @id @default(uuid())
  guardianId   String
  guardian     User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  profileId    String
  profile      KidProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  clientKind   String   @default("WEB")
  deviceName   String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  playStartedAt DateTime?
  lastUsageAt  DateTime?
  breakUntil   DateTime?
  parentAccess KidParentAccess[]
  @@index([guardianId, revokedAt])
  @@index([profileId, revokedAt, expiresAt])
}

/** Guardian-authorized, one-time, short-lived native-device pairing tickets. Codes are never stored in plaintext. */
model KidPairTicket {
  id         String    @id @default(uuid())
  guardianId String
  guardian   User      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  profileId  String
  profile    KidProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  @@index([guardianId, expiresAt, consumedAt])
}


/** Ephemeral, device-initiated pairing: only hashes of all three secrets are retained.
    The low-entropy short code can ONLY be approved by an authenticated guardian with PIN. */
model KidPairRequest {
  id               String   @id @default(uuid())
  deviceSecretHash String   @unique
  approvalHash     String   @unique
  shortCodeHash    String   @unique
  deviceName       String
  guardianId       String?
  guardian         User?    @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  profileId        String?
  profile          KidProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  approvedAt       DateTime?
  claimedAt        DateTime?
  @@index([expiresAt, approvedAt, claimedAt])
  @@index([guardianId, expiresAt])
}

/** Private, nonpublic child ownership of existing server-graded play runs. */
model KidPlayRun {
  runId     String  @id
  run       PlayRun @relation(fields:[runId],references:[id],onDelete:Cascade)
  profileId String
  profile   KidProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  deviceId  String
  createdAt DateTime @default(now())
  @@index([profileId,createdAt])
  @@index([profileId,deviceId])
}

/** Standalone Discover quiz sessions are also linked to the child, never an adult User. */
model KidPlaySingle {
  sessionId String @id
  session   PlaySession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  profileId String
  profile   KidProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  deviceId  String
  createdAt DateTime @default(now())
  @@index([profileId,createdAt])
}

/** In-memory-only guardian session credential, stored hashed and paired to a live native device. */
model KidParentAccess {
  id         String   @id @default(uuid())
  guardianId String
  guardian   User     @relation(fields:[guardianId],references:[id],onDelete:Cascade)
  deviceId   String
  device     KidDeviceSession @relation(fields:[deviceId],references:[id],onDelete:Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  @@index([guardianId,expiresAt])
}

/** Authoritative server-UTC minute slot; unique per child across all paired devices. */
model KidUsageMinute {
  id          String   @id @default(uuid())
  profileId   String
  profile     KidProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  deviceId    String
  utcMinute   Int
  localDay    String
  createdAt   DateTime @default(now())
  @@unique([profileId,utcMinute])
  @@index([profileId,localDay])
  @@index([createdAt])
}

/** No free text or personal identifiers in a child's safety report. Moderators see counts only. */
model KidSafetyReport {
  id         String     @id @default(uuid())
  profileId  String
  profile    KidProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  quizId     String
  quiz       Quiz       @relation(fields:[quizId],references:[id],onDelete:Cascade)
  reason     String
  createdAt  DateTime   @default(now())
  @@unique([profileId,quizId,reason])
  @@index([quizId,reason,createdAt])
}
